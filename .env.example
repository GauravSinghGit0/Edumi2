# Core Django Settings
SECRET_KEY=edumi_ubuntu_prod_secret_key_8f9e7d6c5b4a3f2e1d0_2026
DEBUG=False
ALLOWED_HOSTS=eclass.dei.ac.in,www.eclass.dei.ac.in,localhost,127.0.0.1,*
LOG_LEVEL=INFO

# Local Ubuntu PostgreSQL Database
POSTGRES_DB=edumi_db
POSTGRES_USER=edumi_admin
POSTGRES_PASSWORD=edumi_pass_2026
DATABASE_URL=postgres://edumi_admin:edumi_pass_2026@127.0.0.1:5432/edumi_db

# Local Redis Service
REDIS_URL=redis://127.0.0.1:6379/0

# LiveKit SFU Media Server (HTTPS/WSS)
LIVEKIT_URL=wss://eclass.dei.ac.in/livekit-proxy
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_must_be_32_characters_long_1234

# Security / Cookie Settings (Set to True in production with Let's Encrypt SSL)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Face Recognition Settings
FACE_ENCRYPTION_KEY=ZxYxWvUtSrQpOnMlKjIhGfEdCbA9876543210
FACE_MATCH_THRESHOLD=0.50
FACE_PRESENCE_DURATION=30

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://eclass.dei.ac.in,https://www.eclass.dei.ac.in,https://localhost,https://127.0.0.1,http://eclass.dei.ac.in

# Camera Service Configuration (HTTP endpoint for Nginx proxy_pass)
CAMERA_SERVICE_PORT=8008
CAMERA_SERVICE_URL=http://127.0.0.1:8008

# System Multimedia Binaries (Linux standard path)
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# SMTP Email Configuration (Email Verification & OTPs)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here
DEFAULT_FROM_EMAIL=EduMi Support <your_email@gmail.com>


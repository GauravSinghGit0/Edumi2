# ==============================================================================
# EduMi — Git Attributes & Line Ending Configuration
# Prevents line-ending corruption between Windows and Linux/Ubuntu environments
# ==============================================================================

# Auto detect text files and perform LF normalization on commit
* text=auto

# Linux / Shell Scripts & Container Configurations (CRITICAL: Enforce LF)
*.sh text eol=lf
*.bash text eol=lf
deploy.sh text eol=lf
entrypoint.sh text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Windows Shell Scripts & Batches (Enforce CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
start_app.bat text eol=crlf
start_app.ps1 text eol=crlf

# Python Source Code & Interfaces
*.py text diff=python
*.pyi text diff=python

# Web & Frontend Assets
*.html text
*.css text
*.scss text
*.js text
*.mjs text
*.ts text
*.json text
*.xml text
*.svg text

# Documentation & Configs
*.md text
*.txt text
*.rst text
*.yml text
*.yaml text
*.toml text
*.ini text
*.cfg text
*.conf text
.gitignore text
.gitattributes text
.env.example text

# ==============================================================================
# Binary Files (Explicit binary prevents CRLF corruption & useless git diffs)
# ==============================================================================

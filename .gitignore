# ==============================================================================
# EduMi — Production & Development Git Ignore Rules (.gitignore)
# ==============================================================================

# 1. Environment & Secret Credentials (CRITICAL: NEVER commit secrets!)
.env
.env.local
.env.*.local
.env.prod
.env.dev
.env.production
.env.staging
!.env.example

# 2. Database Files & Persistence
/database/
*.sqlite3
*.sqlite
*.db
db.sqlite3
postgres_data/
/postgres_data/

# 3. Python Cache & Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 4. Django Runtime, Logs & Compiled Static Assets
*.log
logs/
/logs/
staticfiles/
/staticfiles/
local_settings.py
celerybeat-schedule*
celerybeat.pid

# 5. Media, User Uploads & Generated Video Recordings
media/
/media/
uploads/
/uploads/
recordings/
/recordings/
ws_debug.log

# 6. Certificates & Security Keys (Keep private keys off git)
certs/
/certs/
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12

# 7. Virtual Environments
venv/
venv*/
env/
ENV/
.venv/
.env_*/

# 8. IDE, Editor & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# 9. Testing & Code Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
load_testing/credentials.json
load_testing/.env.loadtest
load_testing/reports/
debug_test.py
test_all_pages.py

# 10. Local Executables & Pre-compiled Binaries
ffmpeg.exe
ffprobe.exe
ffmpeg-master-latest-win64-gpl/
livekit-bin/
/livekit-bin/

# 11. Temporary Scratch & Migration Archives
scratch/
/scratch/
archive/
/archive/

# Copy this to .env and fill in values

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=*
SERVER_IP=your-server-ip-or-domain
LOG_LEVEL=INFO

# Database (PostgreSQL for Production)
POSTGRES_DB=edumi2
POSTGRES_USER=edumi2
POSTGRES_PASSWORD=your-strong-postgres-password
# Optional: Use DATABASE_URL to connect to external DB (overrides POSTGRES_* settings)
# DATABASE_URL=postgres://user:pass@host:5432/db

# Redis (Required for multi-process channel layers and Celery)
REDIS_URL=redis://redis:6379/0

# LiveKit SFU
# Local dev: run  docker run --rm -p 7880:7880 -p 7881:7881 -p 50000-50200:50000-50200/udp \
#   -v $(pwd)/livekit.yaml:/etc/livekit/config.yaml livekit/livekit-server --config /etc/livekit/config.yaml
LIVEKIT_URL=wss://your-server-ip/livekit-proxy
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_INTERNAL_HTTP_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_must_be_32_characters_long_1234

# For production — use a strong secret (32+ chars) and your server's public address
# LIVEKIT_URL=wss://your-livekit-server.com
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-very-long-secret-at-least-32-chars

# SSL/HTTPS Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Face Recognition Encryption Key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_ENCRYPTION_KEY=your-fernet-key-here
FACE_MATCH_THRESHOLD=0.50
FACE_PRESENCE_DURATION=30

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:8080,http://your-server-ip,http://your-server-ip:8080,https://your-domain.com

# Camera Service URL
CAMERA_SERVICE_URL=http://camera_service:8003
